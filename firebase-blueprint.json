{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Company workspace configuration and brand identity owned by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "currency": {
          "type": "string",
          "enum": ["MMK", "USD"]
        },
        "fiscalYear": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "tagline": {
          "type": "string",
          "maxLength": 200
        },
        "brandVoice": {
          "type": "string",
          "maxLength": 300
        },
        "mission": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "slug", "currency", "fiscalYear", "createdAt", "updatedAt"]
    },
