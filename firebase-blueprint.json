  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Root workspace owned by the authenticated user."
    },
    "/workspaces/{workspaceId}/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employees belonging to the workspace."
    },
    "/workspaces/{workspaceId}/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Departments belonging to the workspace."
    },
    "/workspaces/{workspaceId}/hrRequests/{requestId}": {
      "schema": { "$ref": "#/entities/HrRequest" },
      "description": "HR requests, attendance, recruitment, checklists, and kudos."
    },
    "/workspaces/{workspaceId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "CRM customers belonging to the workspace."
    },
    "/workspaces/{workspaceId}/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "CRM scheduled meetings belonging to the workspace."
    },
    "/workspaces/{workspaceId}/deals/{dealId}": {
      "schema": { "$ref": "#/entities/Deal" },
      "description": "Sales deals and orders belonging to the workspace."
    },
    "/workspaces/{workspaceId}/salesDocs/{docId}": {
      "schema": { "$ref": "#/entities/SalesDoc" },
      "description": "Sales knowledge articles, staff threads, targets, and follow-ups."
    },
    "/workspaces/{workspaceId}/marketingItems/{itemId}": {
      "schema": { "$ref": "#/entities/MarketingItem" },
      "description": "Marketing products, editorial calendar items, and campaigns."
    },
    "/workspaces/{workspaceId}/financeEntries/{entryId}": {
      "schema": { "$ref": "#/entities/FinanceEntry" },
      "description": "Finance ledger, journal, claims, receipts, AR/AP, budgets, accounts, and cash rules."
    }
  }
}
